# Connexion MongoDB (ex. MongoDB Atlas M0, gratuit)
MONGO_URI=
JWT_SECRET=
# "production" en prod (active COOKIE_DOMAIN)
NODE_ENV=
# Domaine du cookie d'auth en prod, ex. .badam.app
COOKIE_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# URL du front (CORS HTTP + Socket.IO), ex. https://www.badam.app
CLIENT_URL=
# Uniquement en local / Render
PORT=3000
